# MuslimSolo Audio — environment configuration
# Copy to .env.local and fill in for LIVE mode. All values are optional;
# without them the studio runs in DEMO mode (changes stay in the browser).

# GitHub repo that stores content JSON ("owner/name").
VITE_GITHUB_REPO=your-org/muslimsolo_audio
VITE_GITHUB_BRANCH=main

# Cloudflare Worker endpoint that issues R2 presigned upload URLs.
VITE_R2_WORKER_URL=https://muslimsolo-r2-presign.your-subdomain.workers.dev

# Public base URL serving audio from R2.
VITE_AUDIO_PUBLIC_BASE=https://audio.muslimsolo.id

# Set to "false" to enable live mode by default (otherwise demo mode).
VITE_STUDIO_MOCK=true

# Studio admin login (Login Admin tab). Override the defaults below.
VITE_ADMIN_USER=admin
VITE_ADMIN_PASS=mediamuslimsolo13245
